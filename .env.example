# Three separate environment files are built from this example:
# 1) .env - used to replace ${VARIABLE_NAME} interpolation inside docker files (e.g. docker-compose.yml)
# 2) .env.dev - passed into the development containers (e.g. replaces values like os.environ.get("DJANGO_SECRET_KEY") in Django settings )
# 3) .env.prod - passed into the production containers for use by Django settings

# Django Settings
DJANGO_ENV=dev # dev or prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=*
DJANGO_LOGLEVEL=info
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# Database Settings
DATABASE_ENGINE=postgresql
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=